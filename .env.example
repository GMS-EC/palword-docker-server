# ========================================================
# PALWORLD SERVER MANAGER - CONFIGURACIÓN DEL CONTENEDOR
# ========================================================
# Toda la configuración de Palworld (nombre, contraseñas,
# límite de jugadores, multiplicadores, tasas, webhooks,
# copias de seguridad y tareas programadas) se gestiona
# directamente desde la Interfaz Web: http://localhost:8080
# ========================================================

# Zona horaria del contenedor
TZ=America/Guayaquil

# Credenciales de acceso al Panel Web
PANEL_USER=admin
PANEL_PASSWORD=adminpassword
PANEL_PORT=8080

# Clave secreta para la firma criptográfica de sesiones (HMAC-SHA256)
# Opcional: si se deja vacía o no se define, el sistema genera automáticamente
# una clave aleatoria segura de 64 caracteres (secrets.token_hex(32)) en el primer inicio
# y la guarda de forma persistente en el volumen de datos.
# SECRET_KEY=tu_clave_secreta_personalizada_aqui

# Identificadores de usuario/grupo en Linux (opcional)
PUID=1000
PGID=1000
